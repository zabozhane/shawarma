# Скопируйте в .env и поменяйте значения. Всё, кроме DATABASE_URL, можно не трогать для локального запуска.
DATABASE_URL=postgres://postgres@localhost:5432/shawarma
PUBLIC_URL=http://localhost:3000
PORT=3000

# Длинная случайная строка. На сервере обязательно своя.
SESSION_SECRET=change-me

# Первый владелец создаётся при первом запуске. Пароль потом смените в админке.
ADMIN_LOGIN=owner
ADMIN_PASSWORD=shawarma

# Часовой пояс ларька
TZ_SHOP=Europe/Moscow

# Почта для кодов входа и уведомлений. Без SMTP_HOST письма печатаются в консоль.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Шаурма <no-reply@example.ru>

# Ключи для пуш-уведомлений. Если пусто, создаются сами и хранятся в базе.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.ru

# На сервере с HTTPS поставьте true
COOKIE_SECURE=false
